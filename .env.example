# ═══════════════════════════════════════════════════════════════
# NomadAir - Variables d'environnement Frontend
# ═══════════════════════════════════════════════════════════════
# Copie ce fichier en .env et remplis les valeurs

# Titre de l'application (affiché dans le navigateur)
VITE_APP_TITLE=NomadAir

# Description de l'application
VITE_APP_DESCRIPTION=NomadAir - Conciergerie premium pour locations courte durée

# URL du logo (optionnel)
VITE_APP_LOGO_URL=

# URL de l'API backend (pour le développement local)
# VITE_API_BASE_URL=http://localhost:8000